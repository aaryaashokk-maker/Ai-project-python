import cv2
import matplotlib.pyplot as plt
image = input("The file location of the image you want to edit: ")
imagecv2 = cv2.imread(image)
rgb_image = cv2.cvtColor(imagecv2, cv2.COLOR_BGR2RGB)
plt.imshow(rgb_image)
plt.show()

gray_image = cv2.cvtColor(imagecv2, cv2.COLOR_BGR2GRAY)
plt.imshow(gray_image, cmap='gray')
plt.show()

crop_image = imagecv2[100:400, 100:400]
crop_rgb_image = cv2.cvtColor(crop_image, cv2.COLOR_BGR2RGB)
plt.imshow(crop_rgb_image)
plt.show()
