import cv2
import matplotlib.pyplot as plt

image = cv2.imread(r"C:\Users\Aarya\Downloads\beautiful-landscape-with-mountain-lake-and-green-forest-in-the-background-photo.jpg")
image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
width,height,_ = image.shape
center1 = (width//2,height//2-150)
cv2.rectangle(image_rgb, (319, 239),(600, 300), (0,255,0), -10)
cv2.circle(image_rgb, center1, 100, (255,0,0), -10)
cv2.line(image_rgb, (0, 0), (width-100, height-100), (0, 0, 255), 5)
cv2.arrowedLine(image_rgb, (100, 100), (461, 100), (255, 255, 0), 5)
Font = cv2.FONT_HERSHEY_SCRIPT_COMPLEX
cv2.putText(image_rgb, "Aarya", (50, 50), Font, 1, (125, 255, 255), 2)
plt.imshow(image_rgb)
plt.show()
