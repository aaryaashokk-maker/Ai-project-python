import random
name = input("Enter your name : ")
while True:
    b = list("123456789")
    print(f"Choose X or O {name} : ")
    OorX = input().upper()
    ai = "O" if OorX == "X" else "X"
    while True:
        print(b[0], "|", b[1], "|", b[2])
        print("--+---+--")
        print(b[3], "|", b[4], "|", b[5])
        print("--+---+--")
        print(b[6], "|", b[7], "|", b[8])
        n = int(input(f"{name} Choose a number from 1 to 9 : "))-1
        if b[n].isdigit():
            b[n] = OorX
        else:
            print("Invalid input")
            continue
        w =[(0,1,2),(3,4,5),(6,7,8),(0,3,6),(1,4,7),(2,5,8),(0,4,8),(2,4,6)]
        if any(b[x]==b[y]==b[z]==OorX for x,y,z in w):
            print(f"{name} You won the game!")
            break
        empty = [i for i in range(9) if b[i].isdigit()]
        if not empty:
            print("It's a tie!")
            break
        b[random.choice(empty)] = ai
        if any(b[x]==b[y]==b[z]==ai for x,y,z in w):
            print(f"{name} you lost, AI won!")
            break
    if input("Do you want to play again (yes/no) : ").lower()!= "yes":
        break
