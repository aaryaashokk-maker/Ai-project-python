import pandas as pd
from textblob import TextBlob
df = pd.read_csv("IMDB Dataset (1).csv")
df
def recommend(Genre,mood,IMDB_Rating):
  usermood = TextBlob(mood).sentiment.polarity
  data = df[df['Genre'].str.contains(Genre, case = False, na = False)]
  data = data[data['IMDB_Rating']  >= IMDB_Rating]
  results = []
  for _,row in data.iterrows():
    polofover = TextBlob(str(data['Overview'])).sentiment.polarity
    if polofover >= 0 and usermood >= 0:
      results.append(row['Series_Title'])
    elif usermood < 0:
      results.append(row['Series_Title'])
    return results
mood = input("What mood of series do you want : ")
genre = input("What genre do you want : ")
rating = float(input("What rating do you want out of 10 : "))
print(recommend(genre,mood,rating))
